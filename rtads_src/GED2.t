ylica: room
     sdesc = "<b>Перед трактиром</b>"
	 ldesc = "Из распахнутой настеж двери вывалило три пьяных потёртых личности, одна из которых запнулась и упала. Двое других попытались было поднять товарища, но вдруг плюнули на это дело и оставили его лежать прямо на пыльной дороге. У двери стоит несколько вызывающе одетых, но очень неухоженных женщин. Промысел их очевиден. Одна из них весьма молода, она призывно улыбается и видно, что у нее нет нескольких зубов. Она не стесняясь смотрит прямо в глаза и предлагает свои услуги по совсем бросовой цене. Волосы её всклочены, взгляд безумен. Над дверью трактира криво висит вывеска \"Хрюкающий кабан\"."
west = bardoor1
south = glavnaya
;
glavnaya: room
        sdesc = "<b>Главная улица</b>"
		ldesc = "Главная улица. Здесь оживлённое движение. Во все стороны по своим делам торопятся разнообразнейшие по виду горожане. Кто-то неспеша везет на небольших тележках свой скарб - кувшины, миски, гусей, пучки соломы. Кто-то куда-то бежит со всех ног и кричит что-то неразборчивое, кажется что-то вроде \"держи вора\". На углу стоит красивая, но бедно одетая девушка с ребенком в руках и просит милостыню. Её сгоняет наглый молодой стражник, уже успевший отрастить пузо, но так и не успевший побрить, или хотя бы вымыть своё лицо. Он мерзко ухмыляется и во рту его что-то блестит. Люди идут по своим делам и то и дело толкаются. Стоило заглядеться, как кто-то толкнул особенно сильно и вдруг побежал и скрылся в толпе. Может быть стоит проверить бумажник? Хотя нет, всё на месте. Всё-таки тут надо быть осторожнее и не отвлекаться."
west = ylicaseraya1
north = ylica
east = 
{
 "Ворота наглуха закрыты. Из города нельзя ни выйти, ни войти в него. Таков приказ начальника стражи! - Сплёвывая жёлтую слюну говорит один из стражников с обкусанной зубочисткой во рту. Он осматривает вас вероятно оценивая нет ли чем поживиться и что-то прикидывает в своём уме лениво озираясь по сторонам.\b";
 return (glavnaya);
}
;
fontanroom: room
      sdesc = "<b>Фонтан</b>"
	  ldesc = "Здесь журчит огромный городской фонтан из белоснежного мрамора. Вокруг постоянно много народа, похоже у горожан это единственный источник питьевой воды. С бидонами, кувшинами и фляжками здесь постоянно собирается наверно всё население города, включая и приезжих. Иногда слышны смех и шутки - не всегда же горевать, но можно заметить и людей шепчушихся о чем-то своём...."
