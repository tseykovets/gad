win: function
{
    "\bВЫ ПРОШЛИ ИГРУ, ПОЗДРАВЛЯЮ!!!\b";
    "\bВыберите: ВОССТАНОВИТЬ сохраненную игру, начать ЗАНОВО, ВЫХОД.\n";
    while (true)
    {
        local resp;
        "\nПожалуйста введите ВОСТАНОВИТЬ, ЗАНОВО, ВЫХОД>";
        resp := upper(input());
        if ((resp = 'ВОССТАНОВИТЬ') or (resp='restore') or (resp='восстановить'))
        {
            resp := askfile('Файл для восстановления:',
                            ASKFILE_PROMPT_OPEN, FILE_TYPE_SAVE);
            if (resp = nil)          "Загрузка не удалась. ";
            else if (restore(resp))  "Загрузка не удалась. ";
            else
            {    parserGetMe().location.lookAround(true);
                scoreStatus(global.score, global.turnsofar);  abort;      }
        }
        else if ((resp = 'ЗАНОВО') or (resp='заново'))
        {
            scoreStatus(0, 0);
            restart();
        }
        else if ((resp = 'ВЫХОД') or (resp='выход'))
        {   terminate();       quit();        abort;}
     } 
}
