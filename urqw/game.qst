/*
The file encoding is UTF-8 without BOM; the newline format is LF
This file is part of Gad game.
*/

:обложка
pln <h1>Гэд</h1>
pln Небольшая игра, повествующая о путешествиях в подземном городе.
pln Авторы оригинальной игры на RTADS: © 2006 Davarg и Nunhan
pln Ремейк на UrqW: © 2025 Никита Цейковец
pln #/$#/$
pln [[Начать игру|инициализация]]
end

:инициализация
invkill
varkill
полено_у_камина = 1
уголь_в_ведре = 1
монета_в_фонтане = 1
шар_на_дне = 1
крыса_расположение = "ведро"
крыса_действия = "[[крыса|крыса_|осмотреть, взять]]"
мусор_расположение = "бак"
мусор_действия = "[[мусор|мусор_|осмотреть, взять]]"
яд_действия = "[[отрава|яд_|осмотреть, взять]]"
демон_действия = "демон_|осмотреть, поговорить, заморозить, xyzzy"
утёс_действия = "утёс_|осмотреть, бросить_шар"
display_use_крыса = "дохлая крыса"
display_use_яд = "отрава"
display_use_пиво = "бутылка пива"
display_use_уголёк = "тлеющий уголёк"
display_use_уголь = "кусок угля"
display_use_ткани = "ткани Лормана"
display_use_шар = "голубой шар"
display_озерцо_осмотреть = "осмотреть"
display_фонтан_выпить_воды = "выпить воды"
display_фонтан_набрать_воды = "набрать воды"
display_озерцо_нырнуть = "нырнуть"
display_озерцо_отравить_воду = "отравить воду"
hide_камин_сжечь_полено = 1
hide_лорман_дать_ткани = 1
hide_озерцо_нырнуть = 1
hide_статуя_разрисовать = 1
hide_озерцо_отравить_воду = 1
hide_фонтан_отравить_воду = 1
hide_котёл_варить_отраву = 1
hide_котёл_положить_крысу = 1
hide_котёл_положить_мусор = 1
hide_фурион_дать_шар = 1
proc монета_переключатель_видимости_действий
proc пиво_переключатель_видимости_действий
proc заморозка_переключатель_видимости_действий
goto введение

:монета_переключатель_видимости_действий
if hide_стражник_дать_монету then hide_стражник_дать_монету = 0 else hide_стражник_дать_монету = 1
if hide_женщина_дать_монету then hide_женщина_дать_монету = 0 else hide_женщина_дать_монету = 1
if hide_хозяин_дать_монету then hide_хозяин_дать_монету = 0 else hide_хозяин_дать_монету = 1
if hide_лорман_дать_монету then hide_лорман_дать_монету = 0 else hide_лорман_дать_монету = 1
if hide_гвардеец_дать_монету then hide_гвардеец_дать_монету = 0 else hide_гвардеец_дать_монету = 1
if hide_мэр_дать_монету then hide_мэр_дать_монету = 0 else hide_мэр_дать_монету = 1
end

:пиво_переключатель_видимости_действий
if hide_женщина_дать_пиво then hide_женщина_дать_пиво = 0 else hide_женщина_дать_пиво = 1
if hide_гвардеец_дать_пиво then hide_гвардеец_дать_пиво = 0 else hide_гвардеец_дать_пиво = 1
end

:заморозка_переключатель_видимости_действий
if hide_фурион_заморозить then hide_фурион_заморозить = 0 else hide_фурион_заморозить = 1
if hide_стражник_заморозить then hide_стражник_заморозить = 0 else hide_стражник_заморозить = 1
if hide_мэр_заморозить then hide_мэр_заморозить = 0 else hide_мэр_заморозить = 1
if hide_демон_заморозить then hide_демон_заморозить = 0 else hide_демон_заморозить = 1
if hide_утёс_бросить_шар then hide_утёс_бросить_шар = 0 else hide_утёс_бросить_шар = 1
end

:введение
pln <h1>Гэд</h1>
pln "Дрянная жизнь", - думал ты, ехав в город Гэд. Тебя тревожил один вопрос: "почему именно ты родился в бедной семье?" Если бы ты родился в другой семье, может тебе бы никогда и не пришлось отвозить заказ Лормана (небольшую повозку, доверху забитую тканями) в этот город нищеты. Но, как всегда бывает, уже почти у города тебя ограбили и притом хорошо ударили по голове.
pln Когда ты очнулся, тебя осенила идея, что Лорман спустит с тебя три шкуры за его товар, поэтому немедленно надо его вернуть и доставить на рынок.
goto серая_улица

:серая_улица
pln <h2>Серая улица</h2>
pln Унылая Серая улица тянется с [[севера|тупик]] на [[юг|угол_серой_и_главной]]. Одним своим видом она уже не предвещает прохожему ничего хорошего. Везде большие лужи грязи. В обшарпанных проходах снуют разного рода тёмные личности. По бокам улицы такие же серые маленькие дома. Глядя в окна, можно заметить танцующие на стенах тени от огня. Некоторые дома настолько бедны, что не имеют трубы, и дым выходит прямо в окно.
pln Название как раз под стать. Однако на улице играют дети, и это ещё вселяет какую-то надежду на будущее этого городка. Слабую, но всё же надежду. Тем не менее, по сторонам засматриваться не стоит. Можно налететь на какого-нибудь прохожего... Или на его нож.
end

:тупик
pln <h2>Тупик</h2>
pln Вот и тупик. Дорога свободна только на [[юге|серая_улица]]. Проход на север завалило обрушенным домом. В развалинах соседи устроили [[свалку|свалка_осмотреть]] отбросов. Из окон мрачно смотрят настороженные [[горожане|горожане_|осмотреть, поговорить]]. Некоторые из них ловят каждый взгляд, каждое движение, кивают на тебя головами и, чему-то ехидно ухмыляясь, негромко переговариваются между собой...
pln Всё это мрачная картина здешней действительности, которую хочется поскорее сменить на более приятный пейзаж.
if осведомлённость_о_развалинах = 1 then pln Однако завал кажется совсем недавним: кирпичи и мусор ещё не покрыты плесенью. Может быть его можно [[разобрать|завал_разобрать]].
if осведомлённость_о_развалинах = 2 then pln На земле виден [[рисунок|рисунок_|осмотреть, нажать]].
if осведомлённость_о_развалинах = 3 then pln На земле виден [[рисунок|рисунок_осмотреть]], под которым скрывается тайный проход, ведущий [[вниз|тёмный_туннель]].
end

:свалка_осмотреть
pln Куча мусора, выкинутого в разрушенный дом доброжелательными соседями. Она не имеет никакого значения.
goto #previous_loc$

:горожане_осмотреть
pln Изуродованные жизнью лица с дикими взглядами мелькают в окнах.
goto #previous_loc$

:горожане_поговорить
pln Как только ты пытаешься приблизиться к кому-то из местных жителей, они предпочитают скрыться внутри своих домов, так что поговорить ни с кем не получается.
goto #previous_loc$

:завал_разобрать
pln Хорошо поработав физически, ты смог немного разгрести завал. Безусловно, твои труды были не напрасны: под руинами обнаружился замысловатой формы рисунок.
осведомлённость_о_развалинах = 2
goto #previous_loc$

:рисунок_осмотреть
pln Рисунок настолько искусен, что лишает слов и намертво завораживает своими узорами и изгибами. Он словно бы светится мягким ровным светом и успокаивает, вселяя надежду. Но что-то здесь не так... Что же?
goto #previous_loc$

:рисунок_нажать
pln Ты только дотронулся кончиками пальцев, как рисунок вдруг вспыхнул красным свечением и медленно стал погружаться в землю, создавая лестницу вниз.
осведомлённость_о_развалинах = 3
goto #previous_loc$

:угол_серой_и_главной
pln <h2>Угол Серой и Главной улиц</h2>
pln Перекрёсток двух улиц. Идущая с [[севера|серая_улица]] на [[юг|серая_перед_рынком]] Серая улица, во всём своём убожестве и грязи, похоже, столкнулась с Главной улицей города, уходящей на [[восток|главная_улица]].
pln Здесь можно встретить напыщенных горожан в богатых одеждах, украшенных разноцветным стеклом, а может даже брильянтами. Однако число их не так велико. В основном они проносятся под крики носильщиков, а впереди бежит слуга с дубинкой, раздающий тумаки направо и налево...
if count_угол_серой_и_главной = 1 or rnd3 = 1 then pln "Скорее посторонись!" - вдруг почти в ухо кричит невысокого роста грязный угольщик и с силой толкает вперёд тележку, направляясь по своим делам.
end

:серая_перед_рынком
pln <h2>Серая улица перед рынком</h2>
pln Перед базаром, что расположен на [[востоке|рынок1]], толчётся уйма народа, начиная от дварфов с Пустошей и заканчивая людьми-ящерами из Трисфальских болот. Каждый из них прибыл сюда ради быстрой наживы и в поисках лучшей жизни, но, как всегда бывает, все грандиозные планы быстро рушатся.
pln Серая улица, уходящая далеко на [[север|угол_серой_и_главной]], ведёт к административному зданию на [[юге|у_мэрии]].
end

:рынок1
pln <h2>Рынок</h2>
pln Базар! Какие тут запреты? Разве можно чем-то утихомирить эту толпу? Разве смолкнет она когда-нибудь?
if count_рынок1 = 1 then pln Совсем рядом под чью-то весёлую песню, распеваемую на неизвестном языке, стонет шарманка. То тут, то там раздаются выкрики торговцев. Какой-то зазывала кричит в самое ухо заученную на зубок скороговорку, приглашая зайти в магазин хозяина и купить все чудеса света со скидкой на вес, цвет и количество. Кто-то открыто тянет за рукав и с воплем "купи, это хороший товар!", однако теряющемся в общем гаме, суёт прямо в лицо здоровенную рыбину, пачкая ей и свою и твою одежду. Кто-то смеётся. Кто-то плачет. Кто-то считает прибыль. А кто-то теряет кошелёк. Над всем этим вдалеке натянута проволока и видны вечные ярмарочные акробаты.
pln Похоже на то, что здесь можно встретить представителя любой расы мира Тэрака.
pln На [[западе|серая_перед_рынком]] расположен выход на Серую улицу, а на [[востоке|рынок2]] проход на более спокойную часть базара.
end

:рынок2
pln <h2>Рынок</h2>
pln Более спокойная часть базара. Здесь располагаются торговцы тканями из разных стран. Тут возникает такое чувство ирреальности, созданное самыми красивыми тканями и палитрой на самый взыскательный вкус. Похоже, само время здесь отступило и дало волю фантазии.
pln Тут же в своей лавке сидит и [[Лорман|лорман_|осмотреть, поговорить, дать_монету, дать_ткани]].
pln На [[западе|рынок1]] расположена шумная часть базара, а на [[востоке|площадь]] площадь с постаментом.
end

:лорман_осмотреть
pln Богато одетый в халат золотистого цвета торговец зазывает к себе посетителей.
goto #previous_loc$

:лорман_поговорить
if ткани_у_лормана
_ then pln "Давай позже, я сейчас занят", - отмахивается Лорман.
_ else pln "Ага, вот ты и пришёл наконец-то. А где ткани?#/$
_Что ты говоришь, тебя ограбили!? Мне плевать! Ты должен доставить их мне. А как ты это сделаешь, меня не волнует.#/$
_Можешь, конечно, сходить к начальнику стражи и разузнать, что да как."#/$
_Лорман очень недоволен.
goto #previous_loc$

:лорман_дать_монету
pln "Ты что мне суёшь? Мне этого не надо", - раздражается Лорман. - "Мои ткани стоили намного больше!"
goto #previous_loc$

:лорман_дать_ткани
pln "Ну вот это уже совсем другой разговор", - говорит Лорман, забирая ткани.
ткани_у_лормана = 1
hide_лорман_дать_ткани = 1
inv- ткани
goto #previous_loc$

:площадь
pln <h2>"Славься, наш защитник!"</h2>
pln На постаменте из дорогого белого мрамора стоит бронзовый [[монумент|статуя_|осмотреть, разрисовать]] начальника стражи. Одной рукой, держащей трезубец, который больше напоминает обычные вилы, он поражает преступность, алчность, в общем все грехи и всё зло в лице какого-то маленького человечка, а другой прижимает к груди и утешает плачущее дитя.
pln Постамент украшен фресками из бронзы, на которых изображены подвиги начальника стражи во славу Короля, родного города и всего Тэрака.
pln На [[западе|рынок2]] расположена спокойная часть базара, а на [[севере|фонтан]] городской фонтан.
end

:статуя_осмотреть
if статуя_разрисована
_ then pln Кто-то разрисовал статую, очень точно подметив истинное звание начальника стражи: "Продажная собака!"
_ else pln Красиво сделанная из бронзы статуя начальнику стражи. Ой как сильно он разозлится, если её испортят.
goto #previous_loc$

:статуя_разрисовать
if уголь
_ then pln Ты прирождённый художник, теперь на бронзовом лице начальника стражи появились чёрные усы и надпись на лбу "Продажная собака!"
_& inv- уголь
_ & статуя_разрисована = 1
_ & hide_статуя_разрисовать = 1
_ else pln Чем ты собрался рисовать?
goto #previous_loc$

:фонтан
pln <h2>Фонтан</h2>
pln Здесь журчит огромный городской [[фонтан|фонтан_|осмотреть, выпить_воды, набрать_воды, отравить_воду]] из белоснежного мрамора. Вокруг постоянно много народа. Похоже, у горожан это единственный источник питьевой воды. С бидонами, кувшинами и фляжками здесь постоянно собирается, наверно, всё население города, включая и приезжих.
if count_фонтан = 1 or rnd3 = 1 then pln Иногда слышны смех и шутки - не всегда же горевать, но можно заметить и людей, шепчущихся о чём-то своём...
pln На [[юге|площадь]] расположена площадь с постаментом.
end

:фонтан_осмотреть
pln Красивый мраморный фонтан, главный источник питьевой воды в городе.
if монета_в_фонтане then pln Похоже, в нём [[что-то|монета_|осмотреть, взять]] блестит.
goto #previous_loc$

:фонтан_выпить_воды
pln Ах, свежая, прохладная вода хорошо утолила жажду.
goto #previous_loc$

:фонтан_набрать_воды
pln Хорошая идея, но пока тебе это не требуется.
goto #previous_loc$

:фонтан_отравить_воду
if яд
_ then pln Ты медленно вылил яд в городской фонтан и решил спрятаться где-нибудь, подремать и переждать.#/$
_Тебя разбудил громкий смех, явно нечеловеческий. Ты решил более не спать, а пойти на эти звуки.#/$
_Твой интерес привёл тебя к мэрии, где разыгралась ужасная феерия: толпа бесят и другой мерзости собралась вокруг предводителя повстанцев.#/$
_В вашем с ним диалоге ты узнал, что служит он древнему демону - Гэду, и в его планы входила совсем не смена власти, а смерть всего города для пополнения армии нежити.#/$
_Вот так бывает иногда...#/$
_Когда ты закончил с ним полемику, Фурион открыл портал и нырнул в него.#/$
_Ты решил, что это на твоих руках лежит смерть всего города, поэтому молнией метнулся к порталу. Демонические создания даже не успели опомниться, как ты уже стоял на твёрдой земле в окружении мрака.
_& inv- яд
_ & goto вход_в_катакомбы
_ else pln Ну и как ты собираешься травить?
goto #previous_loc$

:монета_осмотреть
pln Похоже, это [[монета|монета_взять]].
goto #previous_loc$

:монета_взять
pln Ты достал монету из фонтана.
монета_в_фонтане = 0
inv+ монета
proc монета_переключатель_видимости_действий
goto #previous_loc$

:у_мэрии
pln <h2>У мэрии</h2>
pln Возле мэрии не так людно. Здание окружено стальными прутьями забора, однако ворота открыты. По сторонам от ворот стоят [[два вооружённых стража|стражники_осмотреть]], но они, похоже, дремлют. За ухо одного из них какой-то дерзкий озорник даже заложил [[веточку|веточка_|осмотреть, взять]] с паутиной.
pln На [[севере|серая_перед_рынком]] расположен выход на Серую улицу, а на [[юге|в_мэрии]] вход в мэрию.
if только_что_отказали_в_мэрии then
_ pln <i>Мда, негусто, что теперь-то делать?.. Помощь от властей вряд ли теперь получишь.#/$
_Вдруг к тебе подбежал мальчик и сказал: "Дядя, дядя! Меня просили передать вам, что в развалинах... Вам надо идти к развалинам, там смогут вам помочь!" Так же неожиданно мальчик повернулся и убежал прочь.</i>
_& только_что_отказали_в_мэрии = 0
_ & осведомлённость_о_развалинах = 1
end

:стражники_осмотреть
pln Крепко спящих стражников вряд ли может что-то разбудить, поэтому сейчас кто угодно может зайти в здание мэрии.
goto #previous_loc$

:веточка_осмотреть
pln Веточка с паутиной, заложенная за ухо одного из спящих стражников.
goto #previous_loc$

:веточка_взять
pln Это может разбудить стражу, а тебе лишние сложности на пути в мэрию не нужны.
goto #previous_loc$

:в_мэрии
pln <h2>В мэрии</h2>
pln Внутри здания мэрии очень тихо: начальник стражи не любит шум и предпочитает делать все свои дела в тишине. Длинный коридор, [[ковровые дорожки|ковёр_|осмотреть, взять]] из бордового бархата - какой это потрясающий контраст с Серой улицей!
pln Выход на улицу расположен на [[севере|у_мэрии]], а коридор уходит на [[восток|коридор]].
end

:ковёр_осмотреть
pln Бордовый ковёр отличной работы расстелен вдоль всего коридора.
goto #previous_loc$

:ковёр_взять
pln А материал неплохой. Возможно, Лорману бы он понравился. Вот только ковёр слишком большой. Разве только как-нибудь умудриться отрезать кусок...
goto #previous_loc$

:коридор
pln <h2>Коридор</h2>
if статуя_разрисована
_ then pln Массивная дубовая дверь в кабинет начальника стражи расположена на [[юге|в_кабинет_начальника_стражи]].
_ else pln Массивная дубовая дверь в кабинет начальника стражи расположена на [[юге|в_кабинет_начальника_стражи]]. На карауле стоит [[стражник|гвардеец_|осмотреть, поговорить, дать_монету, дать_пиво]]. По глазам гвардейца видно, что он очень устал, но он не даёт себе расслабляться: в любой момент может выйти Сам, и тогда ему может сильно не поздоровится.
pln Коридор с [[ковровой дорожкой|ковёр_|осмотреть, взять]] тянется с [[запада|в_мэрии]] на [[восток|конец_коридора]].
end

:гвардеец_осмотреть
pln Высокий, с очень серьёзным выражением лица стражник одет в доспехи. Он с честью несёт свою вахту.
goto #previous_loc$

:гвардеец_поговорить
pln "Можно?" - спрашиваешь ты, кивая на дверь кабинета начальника стражи.
if можно_к_начальнику_стражи
_ then p "Ладно, проходи"
_ else p "Не велено пускать"
p , - отвечает стражник.
if гвардеец_пил_пиво
_ then pln
_ else pln #$А через несколько секунд он добавляет: "Что-то горло пересохло. Эх, сейчас бы чего-нибудь выпить".
goto #previous_loc$

:гвардеец_дать_монету
pln "Взятки не беру!" - отказывается стражник.
goto #previous_loc$

:гвардеец_дать_пиво
pln Ты протягиваешь пиво стражнику и многозначительно киваешь на дверь в кабинет его начальника.
pln "Ладно, проходи", - отвечает он, присасываясь к бутылке.
гвардеец_пил_пиво = 1
можно_к_начальнику_стражи = 1
inv- пиво
proc пиво_переключатель_видимости_действий
goto #previous_loc$

:в_кабинет_начальника_стражи
if можно_к_начальнику_стражи then goto кабинет_начальника_стражи
if статуя_разрисована
_ then pln Дверь заперта, и, похоже, внутри никого нет. Наверное, Ролнес отправился разбираться, кто испортил его статую.
_ else pln "Не велено пускать!" - преграждает путь стражник.
goto #previous_loc$

:кабинет_начальника_стражи
pln <h2>Начальник стражи</h2>
pln В кабинете начальника стражи стоит тишина и [[адъютант|адъютант_|осмотреть, поговорить]] начальника с [[кипой бумаг|кипа_бумаг_|осмотреть, взять]]. В тишине слышен лишь звук стального пера, подписывающего документы. За высоким столом еле виден сам [[начальник стражи|начальник_стражи_|осмотреть, поговорить]].
pln Выход из кабинета расположен на [[севере|коридор]].
if count_кабинет_начальника_стражи = 1
_ then время_в_кабинете_начальника_стражи = 0
_ & pln "Кто там ещё?!" - прокричал Ролнес, начальник стражи, - "Что? Подойди и громче скажи, почему ты отрываешь меня от работы. Если ты не по делу, тогда ух как тебе не поздоровится!"
время_в_кабинете_начальника_стражи = время_в_кабинете_начальника_стражи + 1
if можно_к_начальнику_стражи then proc нетерпение_начальника_стражи
if not можно_к_начальнику_стражи then proc злость_начальника_стражи
end

:нетерпение_начальника_стражи
if время_в_кабинете_начальника_стражи = 2 then pln <i>"Ну!" - раздражённо смотрит на тебя Ролнес.</i>
if время_в_кабинете_начальника_стражи = 3 then pln <i>"Я долго буду ждать?!" - всё больше раздражается Ролнес.</i>
if время_в_кабинете_начальника_стражи = 4 then cls & p "Пошёл вон отсюда!" - взрывается Ролнес. -#$
_& goto выгоняют_из_кабинета_начальника_стражи
end

:злость_начальника_стражи
if время_в_кабинете_начальника_стражи = 2 then pln <i>"Я сказал вон!" - орёт Ролнес.</i>
if время_в_кабинете_начальника_стражи = 4 then cls & goto выгоняют_из_кабинета_начальника_стражи
end

:выгоняют_из_кабинета_начальника_стражи
pln "Стража!"
pln В кабинет вошёл стражник и за шкирку выкинул тебя из мэрии.
можно_к_начальнику_стражи = 0
только_что_отказали_в_мэрии = 1
forget_procs
goto у_мэрии

:адъютант_осмотреть
pln Молодой адъютант начальника стражи. Вряд ли он что-то тут решает.
goto #previous_loc$

:адъютант_поговорить
pln Вряд ли есть смысл с ним о чём-то говорить. Особенно в присутствии начальника стражи.
goto #previous_loc$

:кипа_бумаг_осмотреть
pln Куча каких-то бумаг. Наверняка очень важных.
goto #previous_loc$

:кипа_бумаг_взять
pln Попытка завладеть бумагами в присутствии начальника и его адъютанта, да ещё и стражи за дверью, наверняка закончится плохо.
goto #previous_loc$

:начальник_стражи_осмотреть
pln Это невысокого роста, очень сердитого и мрачного вида мужчина. Он оказался совсем не похож на того человека, которого ты себе представлял до сих пор.
goto #previous_loc$

:начальник_стражи_поговорить
if можно_к_начальнику_стражи
_ then pln Ты объяснил ему ситуацию, на что Ролнес улыбнулся и сказал, что он очень занят, но за определённую плату готов тебе помочь.#/$
_"Да как вам не совестно брать деньги за то, что вы итак обязаны делать?!" - возмутился ты.#/$
_"Вон отсюда, пока я не позвал стражу!" - разъярился Ролнес.
_& можно_к_начальнику_стражи = 0
_ & время_в_кабинете_начальника_стражи = 0
_ & только_что_отказали_в_мэрии = 1
_ else cls & goto выгоняют_из_кабинета_начальника_стражи
goto #previous_loc$

:конец_коридора
pln <h2>Конец коридора</h2>
pln Возле кабинета мэра, расположенного на [[юге|в_кабинет_мэра]], тишина, но не такая мрачная. Здесь нет гвардейцев, никто не несёт вахту. Красивую резную дверь с изящной ручкой можно запросто открыть и войти.
pln Коридор с [[ковровой дорожкой|ковёр_|осмотреть, взять]] уходит на [[запад|коридор]].
end

:в_кабинет_мэра
время_в_кабинете_мэра = 0
goto кабинет_мэра

:кабинет_мэра
pln <h2>Мэр</h2>
pln Богато, но совершенно безвкусно обставленный кабинет мэра. В углу на специальной высокой подставке стоит клетка с какой-то пёстрой [[птицей|птица_|осмотреть, взять]].
if мэр_заморожен
_ then pln За дорогим столом сидит замороженный [[мэр|замороженный_мэр]].
_ else pln За дорогим столом сидит [[человек|мэр_|осмотреть, поговорить, дать_монету, заморозить]], потерявший форму и раздувшийся как пивная бочка.
if not мэр_заморожен and время_в_кабинете_мэра = 0 then pln Он задумчиво что-то выковыривает из носа своим толстеньким как сарделька пальцем. Заметив посетителя, он спохватывается и пытается сделать вид, что на самом деле был занят какими-то очень важными делами.
pln Выход из кабинета расположен на [[севере|конец_коридора]].
время_в_кабинете_мэра = время_в_кабинете_мэра + 1
if время_в_кабинете_мэра = 1 then pln Птица внимательно смотрит на тебя одним глазом.
if время_в_кабинете_мэра = 2 then pln <i>Птица кричит фразу: "Он уже среди нас!"</i>
if время_в_кабинете_мэра = 3 then pln <i>Птица заснула.</i>
if время_в_кабинете_мэра = 6 then pln <i>Птица проснулась и снова принялась изучать тебя.</i>
end

:птица_осмотреть
pln Очень пёстрая птица с длинным клювом и забавным хохолком сидит на жёрдочке.
goto #previous_loc$

:птица_взять
pln Взять птицу мешает клетка, в которой она заперта. А как отпереть клетку не очень понятно.
goto #previous_loc$

:замороженный_мэр
pln От него и раньше-то было мало толку, а теперь в замороженном состоянии он и вовсе бесполезен и не имеет никакого значения.
goto #previous_loc$

:мэр_осмотреть
pln Ленивый, абсолютно нежелающий что-либо менять в городе, мэр весело смотрит на тебя. Оно и правильно, чего ему быть расстроенным, если он лишь кукла в руках начальника стражи.
goto #previous_loc$

:мэр_поговорить
pln "Господин мэр, у меня..."
pln "О, нет, нет!.. Обратитесь к начальнику стражи. Этим он занимается", - прерывает тебя мэр, даже не дав договорить.
pln Он явно ничего здесь не решает. И это его полностью устраивает.
goto #previous_loc$

:мэр_дать_монету
pln Вряд ли такого человека можно заинтересовать твоей жалкой монетой.
goto #previous_loc$

:мэр_заморозить
pln Ледяной вихрь вырвался из голубого шара и в мгновение ока превратил мэра в ледяную статую.
мэр_заморожен = 1
goto #previous_loc$

:главная_улица
pln <h2>Главная улица</h2>
pln Здесь оживлённое движение. Во все стороны по своим делам торопятся разнообразнейшие по виду горожане. Кто-то неспеша везёт на небольших тележках свой скарб: кувшины, миски, гусей, пучки соломы. Кто-то куда-то бежит со всех ног и кричит что-то неразборчивое, кажется, что-то вроде "держи вора".
pln На углу стоит красивая, но бедно одетая девушка с ребёнком в руках и просит милостыню. Её сгоняет наглый молодой [[стражник|стражник_|осмотреть, поговорить, дать_монету, заморозить]], уже успевший отрастить пузо, но так и не успевший побрить или хотя бы вымыть своё лицо. Он мерзко ухмыляется и во рту его что-то блестит.
if count_главная_улица = 1 or rnd3 = 1
_ then pln [[Люди|люди_|осмотреть, поговорить]] идут по своим делам и то и дело толкаются. Стоило заглядеться, как кто-то толкнул особенно сильно и вдруг побежал, и скрылся в толпе. Может быть, стоит проверить бумажник? Хотя нет, всё на месте. Но всё-таки тут надо быть осторожнее и не отвлекаться.
_ else pln [[Люди|люди_|осмотреть, поговорить]] идут по своим делам и то и дело толкаются.
pln Улица идёт от городских ворот на [[востоке|ворота]] до перекрёстка с Серой улицей на [[западе|угол_серой_и_главной]]. На [[севере|перед_трактиром]] расположены злачные места.
end

:стражник_осмотреть
pln Наглый и алчный страж порядка. Он ищет в толпе свою очередную жертву.
goto #previous_loc$

:стражник_поговорить
pln "Так, а ты что тут шныряешь?!" - обращает на тебя внимание наглый стражник с рожей каторжника.
pln "Да нет, ничего... Я так..." - поскорее отходишь ты в сторону от греха подальше.
goto #previous_loc$

:стражник_дать_монету
pln Рожа стражника не внушает доверия, поэтому ты предпочитаешь не иметь с ним дел и не рисковать своей единственной монетой. Вот если бы у тебя их было хотя бы две...
goto #previous_loc$

:стражник_заморозить
pln Ты что - маньяк?! Тут много стражников, а ворота заперты. Даже если ты и успеешь заморозить пару человек, то вряд ли успеешь выбраться из города и скрыться, пока стража не поднимет тревогу и не возьмёт тебя числом.
goto #previous_loc$

:люди_осмотреть
pln Толпа напоминает скорей одно громадное существо, прущее напролом, чем людей.
goto #previous_loc$

:люди_поговорить
pln Все куда-то бегут, так что у тебя не получается кого-нибудь остановить и привлечь к себе внимание.
goto #previous_loc$

:ворота
pln Ворота наглухо закрыты.
pln "Из города нельзя ни выйти, ни войти в него. Таков приказ начальника стражи!" - сплёвывая жёлтую слюну, говорит [[один из стражников|стражник_|осмотреть, поговорить, дать_монету]] с обкусанной зубочисткой во рту.
pln Он осматривает тебя, вероятно оценивая, нет ли чем поживиться, и что-то прикидывает в уме, лениво озираясь по сторонам.
goto #previous_loc$

:перед_трактиром
pln <h2>Перед трактиром</h2>
if count_перед_трактиром = 1 then pln Из распахнутой настежь двери вывалило три пьяных потёртых личности, одна из которых запнулась и упала. Двое других попытались было поднять товарища, но вдруг плюнули на это дело и оставили его лежать прямо на пыльной дороге.
pln У двери стоит несколько вызывающе одетых, но очень неухоженных женщин. Промысел их очевиден. Одна из них весьма молода. Она призывно улыбается и видно, что у неё нет нескольких зубов. [[Женщина|женщина_|осмотреть, поговорить, дать_монету, дать_пиво]], не стесняясь, смотрит тебе прямо в глаза и предлагает свои услуги по совсем бросовой цене.
pln Над дверью трактира на [[западе|трактир]] криво висит вывеска "Хрюкающий кабан".
pln На [[юге|главная_улица]] расположен выход на Главную улицу.
end

:женщина_осмотреть
pln Волосы беззубой женщины всклокочены, взгляд безумен.
goto #previous_loc$

:женщина_поговорить
pln "Малыф, плати деньги и беф рафговоров", - шепеляво говорит женщина.
pln "Да нет, я лучше пойду", - отвечаешь ты.
goto #previous_loc$

:женщина_дать_монету
pln Тебе жалко тратить свою единственную монету на эту неухоженную женщину. Вот если бы у тебя их было хотя бы две...
goto #previous_loc$

:женщина_дать_пиво
pln "Малыф, я работаю только фа деньги", - шепеляво говорит женщина.
goto #previous_loc$

:трактир
pln <h2>Трактир "Хрюкающий кабан"</h2>
pln И не удивительно, что трактир так называется: почти везде пьяные жители, напившиеся до свинячьего визга. Стоит удушливый запах табака и какой-то похлёбки, готовящейся на кухне.
pln Трактир растянулся с [[севера|кухня]] на [[юг|у_камина]], выход на улицу расположен на [[востоке|перед_трактиром]], а на [[западе|у_барной_стойки]] хозяин этого бардака.
end

:кухня
pln <h2>Кухня</h2>
pln Надо же! Трудно поверить, что это кухня, скорее это каморка дворника. Грязные жирные [[кастрюли|кастрюли_|осмотреть, взять]], сваленные в углу, большой закопчённый [[котёл|котёл_|осмотреть, взять, положить_крысу, положить_мусор, варить_отраву]], протёкшее [[ведро помоев|ведро_|осмотреть, взять]], лужа из которого затопила почти весь проход. Тут же рядом на обломанных колёсах стоит ржавый [[мусорный бак|бак_|осмотреть, взять]], принесённый прямо с улицы. Хотя скорее он напоминает мусорную гору, нежели бак.
pln Грязь и жуткая вонь, заставляющая зажать нос. Неужели они здесь готовят еду?!
pln Выход из этого свинарника расположен на [[юге|трактир]].
end

:кастрюли_осмотреть
pln Грязные кастрюли, не знавшие, что такое мытьё, сложены здесь горой.
goto #previous_loc$

:кастрюли_взять
pln Даже не пытайся взять кастрюлю! Ведь ты же не хочешь, чтобы гора кастрюль обрушилась на тебя?
goto #previous_loc$

:котёл_осмотреть
содержимое_котла = ""
if крыса_расположение = "котёл" and мусор_расположение = "котёл" then содержимое_котла = крыса_действия + " и " + мусор_действия
if крыса_расположение = "котёл" and мусор_расположение <> "котёл" then содержимое_котла = крыса_действия
if крыса_расположение <> "котёл" and мусор_расположение = "котёл" then содержимое_котла = мусор_действия
if яд_в_котле then содержимое_котла = яд_действия
if содержимое_котла = "" then содержимое_котла = "ничего нет" else содержимое_котла = "лежит " + содержимое_котла
pln Большой закопчённый котёл, который явно давно никто не чистил.
pln Внутри него #содержимое_котла$.
goto #previous_loc$

:котёл_взять
pln Он слишком велик, так что вряд ли получится вынести его из трактира незаметно.
goto #previous_loc$

:котёл_положить_крысу
pln Ты положил дохлую крысу в котёл.
inv- крыса
крыса_расположение = "котёл"
hide_котёл_положить_крысу = 1
goto #previous_loc$

:котёл_положить_мусор
pln Ты положил мусор в котёл.
inv- мусор
мусор_расположение = "котёл"
hide_котёл_положить_мусор = 1
goto #previous_loc$

:котёл_варить_отраву
if крыса_расположение <> "котёл" and мусор_расположение <> "котёл" then pln А из чего варить? Котёл-то пустой.
if крыса_расположение = "котёл" and мусор_расположение <> "котёл" then pln Буль, буль, буль... Ты варишь в котле дохлую крысу, но чего-то явно не хватает.
if крыса_расположение <> "котёл" and мусор_расположение = "котёл" then pln Буль, буль, буль... Ты варишь в котле мусор, но чего-то явно не хватает.
if крыса_расположение = "котёл" and мусор_расположение = "котёл" then pln Буль, буль, буль... Из дохлой крысы и мусора получилась, наверное, хорошая #яд_действия$.
_& крыса_расположение = ""
_ & мусор_расположение = ""
_ & яд_в_котле = 1
_ & hide_котёл_варить_отраву = 1
goto #previous_loc$

:ведро_осмотреть
pln Протёкшее ведро помоев, которое явно давно никто не выносил.
if крыса_расположение = "ведро" then pln Внутри него лежит #крыса_действия$.
goto #previous_loc$

:ведро_взять
pln Это не особо полезная вещь.
goto #previous_loc$

:крыса_осмотреть
pln Дохлая #крыса_действия$ с облезлым хвостом.
goto #previous_loc$

:крыса_взять
pln Ты взял крысу.
inv+ крыса
крыса_расположение = ""
hide_котёл_положить_крысу = 0
goto #previous_loc$

:бак_осмотреть
pln Ржавый мусорный бак, который явно давно никто не опорожнял.
if мусор_расположение = "бак" then pln Внутри него лежит #мусор_действия$.
goto #previous_loc$

:бак_взять
pln Он слишком большой и тяжёлый.
goto #previous_loc$

:мусор_осмотреть
pln Это какой-то #мусор_действия$ непонятного происхождения. Но выглядит довольно мерзко.
goto #previous_loc$

:мусор_взять
pln Ты взял мусор.
inv+ мусор
мусор_расположение = ""
hide_котёл_положить_мусор = 0
goto #previous_loc$

:яд_осмотреть
pln [[Что-то не очень понятное|яд_взять]], но явно очень несъедобное.
goto #previous_loc$

:яд_взять
pln Ты взял отраву из котла.
inv+ яд
яд_в_котле = 0
goto #previous_loc$

:у_камина
pln <h2>У камина</h2>
pln Возле [[камина|камин_|осмотреть, сжечь_полено]] уютно. Здесь никто не отвлекает, и здесь не особо тревожат громкие пьяные разговоры. Лишь тихий спокойный треск поленьев, заботливо брошенных в огонь, возвращает к реальности.
предметы = "Рядом с камином "
if полено_у_камина then предметы = предметы + "лежит [[полено|полено_|осмотреть, взять]] и "
if уголёк_у_камина then предметы = предметы + "лежит [[тлеющий уголёк|уголёк_|осмотреть, взять]] и "
предметы = предметы + "стоит [[ведро|ведро_у_камина_|осмотреть, взять]]."
pln #предметы$
pln На [[севере|трактир]] отсюда расположен главный зал трактира.
end

:камин_осмотреть
pln Красивый камин, из неизвестного тебе камня, успокаивает и вселяет надежду.
goto #previous_loc$

:камин_сжечь_полено
pln Полено моментально вспыхнуло. От испуга ты уронил его на пол. Так же резко, как оно загорелось, оно и сгорело, оставив лишь маленький тлеющий уголёк. Пожалуй, его можно будет использовать для освещения.
уголёк_у_камина = 1
hide_камин_сжечь_полено = 1
inv- полено
goto #previous_loc$

:полено_осмотреть
pln Обычное небольшое полено. Одно из тех, которыми топят камин.
goto #previous_loc$

:полено_взять
pln Ты взял небольшое полено.
полено_у_камина = 0
hide_камин_сжечь_полено = 0
inv+ полено
goto #previous_loc$

:уголёк_осмотреть
pln Маленький тлеющий уголёк, который можно использовать для освещения.
goto #previous_loc$

:уголёк_взять
pln Ты взял маленький тлеющий уголёк.
уголёк_у_камина = 0
inv+ уголёк
goto #previous_loc$

:ведро_у_камина_осмотреть
pln Обычное старое, кое-где дырявое ведро. Как раз для угля подходит.
if уголь_в_ведре then pln Внутри него лежит [[кусок угля|уголь_|осмотреть, взять]].
goto #previous_loc$

:ведро_у_камина_взять
pln Это не особо полезная вещь.
goto #previous_loc$

:уголь_осмотреть
pln Небольшой [[кусок чёрного угля|уголь_взять]], лежащий в ведре.
goto #previous_loc$

:уголь_взять
pln Ты взял кусок угля.
уголь_в_ведре = 0
inv+ уголь
goto #previous_loc$

:у_барной_стойки
pln <h2>У барной стойки</h2>
pln Судя по поведению, это [[хозяин|хозяин_|осмотреть, поговорить, дать_монету]] трактира. Надо сказать, что внешне он выглядит довольно неприятно. Стоя за стойкой бара, он лишь для вида неспеша протирает своей, похоже, грязной тряпкой пивную [[кружку|кружка_|осмотреть, взять]] и с недоверчивым подозрением косится на тебя.
pln На [[востоке|трактир]] отсюда расположен главный зал трактира.
end

:хозяин_осмотреть
pln Рыжий, толстый хозяин лениво зевает. Он очень похож на жирного рыжего кота, что ленится даже передвигаться.
goto #previous_loc$

:хозяин_поговорить
pln Хозяин что-то буркнул себе под нос и продолжил бездельничать. Он явно не расположен говорить.
goto #previous_loc$

:хозяин_дать_монету
pln Ты отдал хозяину монету. В ответ он дал тебе бутылку пива. Ну что ж, похоже, сдачи ждать не приходится.
inv- монета
inv+ пиво
proc монета_переключатель_видимости_действий
proc пиво_переключатель_видимости_действий
goto #previous_loc$

:кружка_осмотреть
pln Надколотая кружка с порцией выпивки для одного из посетителей.
goto #previous_loc$

:кружка_взять
pln "Моё!" - прорычал один из посетителей, перехватывая кружку.
goto #previous_loc$

:тёмный_туннель
pln <h2>Тёмный туннель</h2>
if уголёк
_ then pln Да, здесь, похоже, тайный проход, идущий на [[восток|родник]]. Ну-ка, ну-ка... Тут еле освещённой стоит крепкая, с резным узором лестница, уходящая [[наверх|тупик]].
_ else pln Вокруг тьма, немного рассеивающаяся светом [[сверху|тупик]], а на [[востоке|прогулки_без_света]] угадывается проход, где тьма ещё гуще.
end

:прогулки_без_света
pln Ты собираешься себе голову разбить в темноте?
goto #previous_loc$

:родник
pln <h2>Родник</h2>
pln Взору открывается небольшая пещера и крохотное [[озерцо||озерцо_осмотреть, фонтан_выпить_воды, фонтан_набрать_воды, озерцо_нырнуть, озерцо_отравить_воду]] в ней. Если приглядеться к поверхности озерца, то заметно лёгкое движение воды. Очевидно, именно здесь берёт своё начало источник, питающий городской фонтан.
pln Туннель идёт с [[запада|тёмный_туннель]] на [[восток|лагерь]].
end

:озерцо_осмотреть
pln Крохотное озерцо в центре пещеры отражает тусклый свет. Его гладкая поверхность едва заметно колышется.
goto #previous_loc$

:озерцо_нырнуть
время_под_водой = 0
goto под_водой

:озерцо_отравить_воду
pln Ты что - маньяк?! Тебе сказали отравить городской фонтан, а не весь источник.
if not яд then pln Да и как ты собираешься травить?
goto #previous_loc$

:лагерь
if previous_loc = "родник" then pln Ты аккуратно прошёл по краю озерца, стараясь не свалиться в него.
pln <h2>Лагерь</h2>
pln Походный бивак повстанцев. Еле дымит костёр. Видна [[полевая кухня|полевая_кухня]]. Остро наточенные пики, украшенные чёрной бахромой, стоят, прислонённые друг к другу. На одеялах, а то и просто на голой земле, спят уставшие бойцы. Два проверяющих идут через лагерь, негромко окликая бодрствующих часовых.
if count_лагерь = 1 then proc лагерь_первое_посищение
if count_лагерь > 1 then proc лагерь_повторные_посищения
pln Выход из лагеря располагается на [[западе|родник]].
if count_лагерь = 1 then save
if автосохранение2 then автосохранение2 = 0 & save
end

:лагерь_первое_посищение
pln Ты осторожно подошёл ближе к этому небольшому разбитому лагерю, стараясь как можно лучше спрятаться в темноте, но случайно поднял шум. В ту же минуту тебя уже связали повстанцы и привели к Фуриону, своему лидеру.
pln Это был рослый чернобородый мужчина лет сорока. Его взгляд был словно бритва. Одет он был в шкуру неизвестного тебе зверя.
pln После недолгого молчания, наступившего в лагере, Фурион громко произнёс басом: "Это не шпион". Естественно, тебя отпустили, и ты смог рассказать свою историю.
pln Внимательно дослушав твой рассказ, Фурион предложил тебе уговор: он обязуется найти и вернуть твои утерянные ткани, но на том условии, что ты сможешь выманить Ролнеса из его кабинета. Выбора у тебя не было, и ты согласился.
hide_статуя_разрисовать = 0
end

:лагерь_повторные_посищения
if статуя_разрисована and hide_фонтан_отравить_воду
_ then proc лагерь_дополнительные_задания
_ else pln В стороне сидит [[Фурион|фурион_|осмотреть, поговорить, дать_шар, заморозить]].
end

:лагерь_дополнительные_задания
pln Как только ты появился в лагере, к тебе подошёл предводитель - Фурион. он поведал, что тебе удалось выманить Ролнеса, разрисовав его статую, но, к сожалению, стража смогла задержать повстанцев, и покушение провалилось. Теперь ещё одного такого шанса не будет. Надо отравить городской фонтан - это единственный способ достать его.
pln На это ты попытался возразить, но Фурион уверил тебя, что жители будут предупреждены. "Впрочем, ты можешь попытаться сбежать вместо выполнения этого задания, но у нас, предупреждаю, длинные руки!" - добавил он.
pln Ну что ж, похоже, тебе так просто от них не отделаться: "длинные руки" произвели на тебя невыгодное впечатление.
pln Когда Фурион уже собрался уходить, ты вспомнил о договоре и напомнил ему об украденных вещах. Фурион с неохотой отдал тебе ткани и дал совет, что лучше места для приготовления яда, чем кухня в трактире, не найти.
pln Так же он добавил, что недавно около родника обронил свой волшебный шар заморозки, и было бы неплохо, если бы ты смог отыскать его и навестить мэра...
hide_озерцо_нырнуть = 0
hide_фонтан_отравить_воду = 0
hide_озерцо_отравить_воду = 0
hide_котёл_варить_отраву = 0
hide_лорман_дать_ткани = 0
inv+ ткани
автосохранение2 = 1
end

:полевая_кухня
pln Всё, что можно разглядеть, так это пара кастрюль, да столик, за которым всё и готовится.
goto #previous_loc$

:фурион_осмотреть
pln Рослый чернобородый мужчина лет сорока с взглядом словно бритва. Это лидер повстанцев.
goto #previous_loc$

:фурион_поговорить
if статуя_разрисована
_ then pln Фурион снова говорит, что тебе нужно отравить городской фонтан, и напоминает про "длинные руки" на случай, если ты захочешь уклониться от этого задания.
_ else pln Фурион напоминает тебе о вашем уговоре: ты должен выманить начальника стражи из его кабинета, а он поможет тебе вернуть ткани.
goto #previous_loc$

:фурион_дать_шар
p "О! Мой волшебный шар заморозки", - говорит Фурион. - "Надеюсь, ты с его помощью передал привет мэру?#$
if мэр_заморожен
_ then pln Да? Отлично! одним препятствием на пути нашего дела стало меньше. Но помни, что наш главный враг - это Ролнес, а чтобы до него добраться, надо отравить городской фонтан."#/$
_С этими словами он забрал шар.
_& inv- шар
_ & hide_фурион_дать_шар = 1
_ & proc заморозка_переключатель_видимости_действий
_ else pln Нет? Ну тогда пока оставь его у себя."
goto #previous_loc$

:фурион_заморозить
pln Ты что - маньяк?! Вокруг в лагере слишком много повстанцев, так что расправиться с Фурионом может и удастся, но это, наверняка, будет последним делом в твоей жизни.
goto #previous_loc$

:под_водой
pln <h2>Под водой</h2>
pln Ух ты, как здесь всё интересно: разные [[морские жучки|живность_|осмотреть, взять]] плавают. В общем Подводное Царство в миниатюре. [[Вверху|родник]] над головой виднеется чуть более светлая поверхность озерца.
if шар_на_дне then pln На дне лежит [[голубой шар|шар_|осмотреть, взять]].
время_под_водой = время_под_водой + 1
if время_под_водой = 2 then pln <i>Воздух выходит из твоих лёгких.</i>
if время_под_водой = 3 then pln <i>Ты задохнулся.</i>& quit
end

:живность_осмотреть
pln Разнообразная подводная живность. Можно попробовать кого-нибудь [[поймать|живность_взять]].
goto #previous_loc$

:живность_взять
pln Ты попробовал поймать какую-нибудь рыбёшку, но сходу у тебя это не получилось.
goto #previous_loc$

:шар_осмотреть
pln Шар голубого цвета. Наверное, это тот самый волшебный шар заморозки, про который говорил Фурион.
goto #previous_loc$

:шар_взять
pln Ты взял голубой шар со дна.
шар_на_дне = 0
inv+ шар
hide_фурион_дать_шар = 0
proc заморозка_переключатель_видимости_действий
goto #previous_loc$

:вход_в_катакомбы
pln <h2>Вход в катакомбы</h2>
pln Здесь очень сыро, темно и страшно. Похоже, это заброшенные катакомбы, сохранившиеся ещё со времён, когда правил король Пакселис. Единственный путь ведёт на [[юг|катакомбы0]].
pln Удивительно, знаешь ли, бывает: природа, если смогла создать слизняков, светящихся в темноте, то это ещё раз подтверждает, что везде жизнь найдёт себе выход.
if count_вход_в_катакомбы = 1 and шар then save
end

:катакомбы0
pln <h2>Катакомбы</h2>
pln Пол, потолок и стены здесь хотя и выложены простым булыжником, но довольно аккуратно. В остальном ничего интересного. Отсюда можно пройти на [[юг|катакомбы6]].
end

:катакомбы6
pln <h2>Катакомбы</h2>
pln Здесь перекрёсток, а в остальном это ровно такая же комната, как и предыдущая. Пройти отсюда можно на [[север|катакомбы0]], [[восток|катакомбы5]], [[запад|катакомбы1]] или [[юг|катакомбы4]].
end

:катакомбы4
pln <h2>Катакомбы</h2>
pln Вряд ли ты увидишь для себя здесь ещё что-либо примечательное. Создаётся впечатление, что это заколдованный лабиринт с совершенно одинаковыми стенами, и не дающий глазу зацепиться за какую-либо примету. Дальше можно пройти на [[восток|катакомбы2]], [[запад|катакомбы5]] или [[юг|катакомбы6]].
end

:катакомбы1
pln <h2>Катакомбы</h2>
pln Везде этот серый камень. Вокруг всё сплошь один серый камень. Всё вокруг одинаковое. Похоже, эти катакомбы заколдованы: ты же двигался на запад, а теперь единственный выход снова на [[западе|катакомбы2]]! Или может быть это ловушка?! Но разве стена за спиной могла возникнуть так бесшумно и быстро?
end

:катакомбы5
pln <h2>Катакомбы</h2>
pln Опять перекрёсток! Такой же, как и прежде, навевающий дурные мысли. Не притаился ли кто во тьме? Не готовит ли нож, или удавку? Не прыгнет ли на спину с безумным криком и топором в скрюченных от ярости пальцах? Холодок пробирает изнутри, здесь довольно прохладно. Идти предстоит на [[север|катакомбы11]], либо [[запад|катакомбы3]].
end

:катакомбы3
pln <h2>Катакомбы</h2>
pln Кромешная всепоглощающая тьма обступает вокруг. Она, словно живое существо, медленно стекающее со стен к твоим ногам и обволакивающее ботинки. От этого чувства неприятно, и мурашки начинают бежать по коже. Свои пасти тьма распахнула на [[западе|катакомбы12]], [[востоке|катакомбы5]], [[севере|катакомбы2]] и, самую тёмную и неприятную, на [[юге|катакомбы7]] отсюда.
end

:катакомбы2
pln <h2>Катакомбы</h2>
pln Ха! Опять проклятый перекрёсток. Куда же идти? Это становится просто невыносимым. Выходы во всех четырёх сторонах света одинаково разинули свои пасти: на [[севере|катакомбы4]], [[юге|катакомбы3]], [[западе|катакомбы3]] и [[востоке|катакомбы8]].
end

:катакомбы7
pln <h2>Озеро огня</h2>
if count_катакомбы7 = 1 then pln Огромное озеро раскалённой лавы простирается во все стороны, а некоторые извержения из лавового озера достают даже до свода этой странной пещеры. И прямо в середине озера сидит на огромном огненном троне [[демон|#демон_действия$]].#/$
_Похоже, он тебя заметил и медленно стал направляться в твою сторону.
if count_катакомбы7 = 2 then pln Ты стоишь на [[скалистом берегу|#утёс_действия$]] лавового озера, по поверхности которого к тебе приближается [[демон|#демон_действия$]].
if count_катакомбы7 = 3 then pln Ты стоишь на [[скалистом берегу|#утёс_действия$]] лавового озера, а [[демону|#демон_действия$]] осталось лишь протянуть лапу, чтобы схватить тебя.
if count_катакомбы7 = 4 then pln Ужасный демон Гэд протягивает к тебе свою лапу, хватает и пожирает тебя!& quit
end

:демон_осмотреть
pln Его внешний вид превосходит всякое разумение: исполинская тень, сплетённая из пламени и первозданной тьмы, чьи контуры искажают само пространство. Длинные лапы тянутся к тебе, а морда представляет собой кошмарную мозаику из множества глаз и пастей, источающих дым и пламя.
pln От одного взгляда на это существо разум начинает разрушаться, словно само сознание пытается закрыться от увиденного, понимая, что подобная мерзость не должна существовать в реальности.
goto #previous_loc$

:демон_поговорить
pln "Эй, давай поговорим!" - пытаешься ты обратиться к демону. Фурион как-то же с ним общался.
pln Но Гэд неотвратимо двигается к тебе, и не похоже, чтобы он вообще воспринимал тебя за разумное существо.
goto #previous_loc$

:демон_заморозить
pln Ты пытаешься заморозить демона с помощью голубого шара, но выходящий из него ледяной вихрь слишком слаб и поглощается раскалённой лавой.
goto #previous_loc$

:демон_xyzzy
pln "XYZZY!!!" - ты выкрикиваешь единственное заклинание, которое приходит тебе на память.
pln Но ничего не происходит. Демон всё также приближается к тебе.
pln Это не сработало. Даже это тут не сработало!
goto #previous_loc$

:утёс_осмотреть
pln Волны раскалённой лавы лижут утёсы, и брызги от них чуть-чуть не долетают до тебя.
goto #previous_loc$

:утёс_бросить_шар
pln Ты бросил шар в ближайший утёс, разбив его о скалы и разом высвободив всю заключённую в нём энергию. В мгновение ока тысячи синих искр разлетелись во все стороны. Стоило им коснуться лавы, как тут же она превращалась в камень.
pln Гэд уже начал протягивать к тебе свою лапу, как на него попали волшебные искры. Душераздирающий крик раздался над всем озером. Это было последнее, что сделал Гэд.
pln #/$#/$
pln ТЫ ПРОШЁЛ ИГРУ, ПОЗДРАВЛЯЮ!!!
quit

:катакомбы11
pln <h2>Катакомбы</h2>
pln Стены здесь сделаны из, наверное, самого серого камня во всём этом мрачном королевстве. От этой неуютной сырости хочется сбежать поскорее. Идти можно на [[восток|катакомбы12]] или [[север|катакомбы13]].
end

:катакомбы13
pln <h2>Катакомбы</h2>
pln Опять тупик! Похоже, здесь под землёй можно так и никогда не найти выход. А может это всего лишь чья-то злая шутка? Как бы там ни было, но идти можно только на [[север|катакомбы7]].
end

:катакомбы12
pln <h2>Катакомбы</h2>
pln Тьма и камень - после нескольких часов прогулки они кажутся проявлением всего самого отвратительного в королевстве. Но это лишь пелена безумия, затмившая разум. Хорошо ещё можно видеть, куда ведут пути: на [[юг|катакомбы13]], [[север|катакомбы10]] и [[восток|катакомбы3]].
end

:катакомбы10
pln <h2>Катакомбы</h2>
pln Так же как на нашем жизненном пути встречаются перекрёстки, ведущие к славе или позору, так и здесь, в окружении вековой тьмы и мудрого камня, тебе приходится выбирать между [[севером|катакомбы6]] и [[югом|катакомбы11]], [[востоком|катакомбы9]] и [[западом|катакомбы8]].
end

:катакомбы8
pln <h2>Катакомбы</h2>
pln "Безумием страдали перед своей смертью почти все великие войны, и теперь я понимаю почему: после целой жизни, проведённой в путешествиях вот по таким подземельям, никто долго не выдержит", - твои слова отражались от стен, словно свет от зеркала. Дорога ведёт только на [[запад|катакомбы9]].
end

:катакомбы9
pln <h2>Катакомбы</h2>
pln Тихое и нервное безумие, порождённое обстановкой, медленно, но верно берёт верх над тобой. Тебе начинает казаться, что эти серые одинаковые камни ожили и мерзко смеются над твоими тщетными попытками найти выход. Можно попытаться сбежать отсюда на [[восток|катакомбы1]] или на [[юг|катакомбы10]].
end
